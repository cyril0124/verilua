#!/usr/bin/env python3

import os
import sys
import subprocess
import shutil

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import vl_mem_direct

RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
RESET = "\033[0m"

PREFIX = f"[{YELLOW}vl-verilator-dpi{RESET}]"

# Wrapper-level mem_direct flags are stripped before invoking verilator.
vl_args, verilator_args = vl_mem_direct.parse_args(sys.argv[1:], PREFIX)

verilua_path = os.getenv("VERILUA_HOME")

libpath = verilua_path + "/shared"
luapath = verilua_path + "/luajit"
liblua_path = luapath + "/lib"

assert os.path.exists(liblua_path + "/libluajit-5.1.so"), "[vl-verilator-dpi] cannot find liblua in " + liblua_path
assert os.path.exists(libpath + "/libverilua_verilator_dpi.so"), "[vl-verilator-dpi] cannot find libverilua_verilator_dpi.so in " + libpath

CFLAGS = ""
LDFLAGS = ""

CFLAGS += f"-I{luapath}/include -I{luapath}/include/luajit-2.1 "
CFLAGS += f"-I{verilua_path}/src/include "

LDFLAGS += f"-Wl,-rpath,{libpath} -L{libpath} -Wl,--no-as-needed -lverilua_verilator_dpi "
LDFLAGS += f"-Wl,-rpath,{liblua_path} -L{liblua_path} -Wl,--no-as-needed -lluajit-5.1 "

verilator = shutil.which("verilator")
assert verilator != None, "[vl-verilator-dpi] cannot find `verilator` in PATH"

cmd_list = [verilator] + [
    "+define+VERILUA",
    "-LDFLAGS", LDFLAGS,
    "-CFLAGS", CFLAGS
] + verilator_args + [f"{verilua_path}/src/dummy_vpi/dummy_vpi.cpp"]

cmd = " ".join(cmd_list)

print(f'''
{PREFIX} libpath: {GREEN}{libpath}{RESET}
{PREFIX} liblua_path: {GREEN}{liblua_path}{RESET}
{PREFIX} verilua_path: {GREEN}{verilua_path}{RESET}
{PREFIX} cmd:
{GREEN}{cmd}{RESET}
''', flush = True)

rc = subprocess.call(cmd_list)
if rc != 0:
    exit(rc)

vl_mem_direct.post_step(vl_args, PREFIX, verilua_path, verilator, verilator_args)
